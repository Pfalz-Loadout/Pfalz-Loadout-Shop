# ------------------------------------------------------------------
# PFALZ LOADOUT – Umgebungsvariablen
# Werte NIE ins Repo schreiben. In Vercel unter
# Project → Settings → Environment Variables eintragen.
# Lokal: Datei .env.local anlegen (wird nicht hochgeladen).
# ------------------------------------------------------------------

# Öffentliche Adresse des Shops (für PayPal-Rücksprung und Mail-Links)
SITE_URL=https://pfalz-loadout.de

# PayPal (developer.paypal.com → Apps & Credentials → App „Pfalz Loadout Shop“)
# sandbox = Testmodus, live = echte Zahlungen
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Überweisung / Vorkasse – erscheint in Bestätigungsmail und auf der Danke-Seite
BANK_INHABER=
BANK_IBAN=
BANK_BIC=
BANK_NAME=

# Mailversand über dein Postfach (Strato: smtp.strato.de, Port 465)
SMTP_HOST=smtp.strato.de
SMTP_PORT=465
SMTP_USER=kontakt@pfalz-loadout.de
SMTP_PASS=
MAIL_FROM="PFALZ LOADOUT <kontakt@pfalz-loadout.de>"
MAIL_SHOP_TO=kontakt@pfalz-loadout.de

# Geheimer Schlüssel für Bestätigungslinks (Drop-Info Double-Opt-in).
# Beliebige lange Zufallszeichenkette.
SIGNING_SECRET=
